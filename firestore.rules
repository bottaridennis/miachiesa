rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'dennisbottari@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isVerifiedMember(groupId) {
      // Look up if there's a verified membership doc where groupId and userId match
      // We can query group_members collection. But in rules, we can only get a specific document path.
      // So group_members document ID should be: groupId + '_' + userId
      return isAuthenticated() && get(/databases/$(database)/documents/group_members/$(groupId + '_' + request.auth.uid)).data.isVerified == true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) || isSuperAdmin();
      // Allow users to update their own profile, but only SuperAdmin can modify isAdmin
      allow update: if isSuperAdmin() || (isOwner(userId) && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin));
      allow delete: if isSuperAdmin();
    }
    
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /group_members/{memberId} {
      allow read: if true;
      // Users can request to join a group, but they can't set themselves as verified
      allow create: if (isOwner(request.resource.data.userId) && request.resource.data.isVerified == false) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    match /notices/{noticeId} {
      allow read: if true;
      allow create: if isAdmin() || (isOwner(request.resource.data.authorId) && isVerifiedMember(request.resource.data.groupId));
      allow update, delete: if isAdmin() || isOwner(resource.data.authorId);
    }
    
    match /messages/{messageId} {
      allow write: if true;
      allow read, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mass_times/{massTimeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /liturgy/{liturgyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /form_submissions/{submissionId} {
      allow write: if true;
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /user_favorites/{favoriteId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /service_options/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_settings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /visitors/{visitorId} {
      allow write: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /community_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
