# Configurazione Firebase.
# In locale puoi:
#   1) mettere il file firebase-applet-config.json nella root del progetto (ignorato da git), oppure
#   2) impostare FIREBASE_APPLET_CONFIG con il contenuto JSON del file.
# In GitHub Actions viene letto dal secret FIREBASE_APPLET_CONFIG.
FIREBASE_APPLET_CONFIG='{"projectId":"...","appId":"...","apiKey":"...","authDomain":"...","firestoreDatabaseId":"...","storageBucket":"...","messagingSenderId":"..."}'

# Email del super amministratore (opzionale, default nel codice)
VITE_SUPER_ADMIN_EMAIL="admin@example.com"
